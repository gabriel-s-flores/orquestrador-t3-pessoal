#!/usr/bin/env python3
# Semáforo para comandos pesados, para vários agentes rodarem sem travar a máquina.
# Uso: <estado>/bin/slot <build|test|browser|install> -- <comando...>
#   Comando com pipe, redirecionamento ou VAR=valor na frente: -- bash -c '<comando>'
# - Vagas por classe: SLOTS_BUILD, SLOTS_TEST, SLOTS_BROWSER, SLOTS_INSTALL (orq.env).
# - Espera vaga (e a máquina sair do estado crítico) até SLOT_ESPERA_MAX_MIN; depois sai com 75 (tente de novo).
# - Linux: roda com nice/ionice e, se SLOT_MEM_MAX estiver definido e o systemd do usuário responder, num escopo com
#   teto de memória. Windows: prioridade abaixo do normal e, com SLOT_MEM_MAX, um Job Object com o mesmo teto. Nos
#   dois, um build que estoura o teto cai sozinho em vez de levar a máquina para o swap.
# - Exporta ORQ_JOBS (núcleos por comando pesado) e MAKEFLAGS=-j$ORQ_JOBS se não houver.
import os, sys, time, shutil, subprocess
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _orq import WIN, estado, params, travar, comando, metricas
O = estado(); P = params(O)
for k, v in P.items():  # como o _comum.sh: o orq.env vai para o ambiente dos filhos
    os.environ.setdefault(k, v)
os.environ['ORQ'] = O

a = sys.argv[1:]
classe = a[0] if a else ''
if classe not in ('build', 'test', 'browser', 'install'):
    print('uso: slot <build|test|browser|install> -- <comando...>', file=sys.stderr); sys.exit(64)
cmd = a[1:]
if cmd and cmd[0] == '--':
    cmd = cmd[1:]
if not cmd:
    print('slot: falta o comando', file=sys.stderr); sys.exit(64)

def inteiro(k, padrao):
    try: return int(float(P.get(k) or padrao))
    except ValueError: return padrao
n = max(1, inteiro(f'SLOTS_{classe.upper()}', 1))
lockdir = os.path.join(O, 'locks')
cpus = os.cpu_count() or 1
jobs = max(1, cpus // (inteiro('SLOTS_BUILD', 1) + inteiro('SLOTS_TEST', 1)))
os.environ['ORQ_JOBS'] = str(jobs)
os.environ.setdefault('MAKEFLAGS', f'-j{jobs}')

def bytes_de(txt):
    txt = (txt or '').strip().upper().rstrip('B')
    if not txt: return 0
    mult = {'K': 1024, 'M': 1024 ** 2, 'G': 1024 ** 3, 'T': 1024 ** 4}.get(txt[-1], 1)
    try: return int(float(txt.rstrip('KMGT')) * mult)
    except ValueError: return 0

def critico():  # load muito acima do teto ou memória livre abaixo de metade da reserva
    try:
        m = metricas(amostra_s=0.5)
    except Exception:
        return False
    try: crit = float(P.get('CARGA_CRITICA') or 999); reserva = float(P.get('RESERVA_MEM_GB') or 0)
    except ValueError: return False
    return m['load1'] > crit or m['livre'] < reserva / 2

def job_windows(teto):
    """Job Object com teto de memória para a árvore do comando (equivalente ao escopo do systemd-run)."""
    import ctypes
    from ctypes import wintypes
    k32 = ctypes.WinDLL('kernel32', use_last_error=True)
    k32.CreateJobObjectW.restype = wintypes.HANDLE
    class IO(ctypes.Structure):
        _fields_ = [(x, ctypes.c_ulonglong) for x in ('r', 'w', 'o', 'rb', 'wb', 'ob')]
    class BASICA(ctypes.Structure):
        _fields_ = [('PerProcessUserTimeLimit', ctypes.c_longlong), ('PerJobUserTimeLimit', ctypes.c_longlong),
                    ('LimitFlags', wintypes.DWORD), ('MinimumWorkingSetSize', ctypes.c_size_t),
                    ('MaximumWorkingSetSize', ctypes.c_size_t), ('ActiveProcessLimit', wintypes.DWORD),
                    ('Affinity', ctypes.c_size_t), ('PriorityClass', wintypes.DWORD), ('SchedulingClass', wintypes.DWORD)]
    class ESTENDIDA(ctypes.Structure):
        _fields_ = [('Basic', BASICA), ('Io', IO), ('ProcessMemoryLimit', ctypes.c_size_t),
                    ('JobMemoryLimit', ctypes.c_size_t), ('PeakProcessMemoryUsed', ctypes.c_size_t),
                    ('PeakJobMemoryUsed', ctypes.c_size_t)]
    job = k32.CreateJobObjectW(None, None)
    if not job:
        return None
    info = ESTENDIDA(); info.Basic.LimitFlags = 0x200  # JOB_OBJECT_LIMIT_JOB_MEMORY
    info.JobMemoryLimit = teto
    if not k32.SetInformationJobObject(wintypes.HANDLE(job), 9, ctypes.byref(info), ctypes.sizeof(info)):
        return None
    return job

def rodar():
    final = comando(cmd)
    if WIN:
        teto = bytes_de(P.get('SLOT_MEM_MAX'))
        job = job_windows(teto) if teto else None
        flags = 0x4000 | (0x4 if job else 0)  # BELOW_NORMAL_PRIORITY_CLASS, CREATE_SUSPENDED
        try:
            p = subprocess.Popen(final, creationflags=flags)
        except OSError as e:
            print(f'slot: não consegui rodar {final[0]}: {e}', file=sys.stderr); return 127
        if job:
            import ctypes
            ok = ctypes.windll.kernel32.AssignProcessToJobObject(ctypes.c_void_p(job), ctypes.c_void_p(int(p._handle)))
            if not ok:
                print('slot: sem teto de memória (o processo não entrou no Job Object)', file=sys.stderr)
            ctypes.WinDLL('ntdll').NtResumeProcess(ctypes.c_void_p(int(p._handle)))
        try:
            return p.wait()
        except KeyboardInterrupt:
            p.terminate(); return 130
    run = ['nice', '-n', '10']
    if shutil.which('ionice'):
        run += ['ionice', '-c2', '-n7']
    if P.get('SLOT_MEM_MAX') and shutil.which('systemd-run'):
        escopo = ['systemd-run', '--user', '--scope', '--quiet', '-p', f'MemoryMax={P["SLOT_MEM_MAX"]}', '-p', 'MemorySwapMax=0', '--']
        if subprocess.run(escopo + ['true'], capture_output=True).returncode == 0:
            run += escopo
    try:
        return subprocess.call(run + final)
    except KeyboardInterrupt:
        return 130

inicio = time.time(); aviso = 0.0
limite = 60 * float(P.get('SLOT_ESPERA_MAX_MIN') or 15)
while True:
    if not critico():
        for i in range(1, n + 1):
            trava = travar(os.path.join(lockdir, f'{classe}-{i}.lock'))
            if trava:
                try:
                    sys.exit(rodar())
                finally:
                    trava.close()
    agora = time.time()
    if agora - inicio >= limite:
        print(f'slot: sem vaga de {classe} em {P.get("SLOT_ESPERA_MAX_MIN") or 15} min; tente de novo mais tarde', file=sys.stderr)
        sys.exit(75)
    if agora - aviso >= 60:
        motivo = 'máquina em estado crítico' if critico() else f'{n} vaga(s) de {classe} ocupada(s)'
        print(f'slot: esperando ({motivo}) há {int(agora - inicio)}s', file=sys.stderr); aviso = agora
    time.sleep(10)
