# Parâmetros desta orquestração (lidos pelos scripts em bin/ e pelo orquestrador). Sem espaços em volta do "=".
ORQ_ID="<slug-curto>"                  # prefixo dos clientRequestId e da branch orq/ORQ_ID
ORQ_NOME="🎛️ Orquestrador <nome>"     # título da thread do orquestrador no T3
T3_PROJETO="<id-do-projeto-t3>"        # t3_project_list
REPO="<dono>/<repo>"                   # repositório no GitHub
BASE="<branch-do-epico>"               # branch do épico: tudo se consolida nela, por PR (ex.: epico-login)
ORIGEM="main"                          # de onde o épico nasce e que ele acompanha; só leitura
SYNC_ORIGEM="gate"                     # traz a ORIGEM para o épico: gate (em cada gate e no fim) | nunca
BRANCHES_PROTEGIDAS="main master develop"   # nunca recebem push, merge nem PR deste fluxo (AMBIENTE.md)
PREFIXO="feature"                      # branches das tarefas: PREFIXO/<id-da-tarefa> ou **Branch:** no BACKLOG
CHECKOUT="<caminho-da-worktree-orq>"   # worktree da thread do orquestrador (branch orq/ORQ_ID), só fast-forward

# Paralelismo (valores de bin/capacidade.sh --sugerir)
MAX_AGENTES=6                          # implementadores + revisores rodando ao mesmo tempo
DESPACHO_POR_ITERACAO=2                # worktrees novas por iteração (o setup de cada uma é pesado)
CARGA_MAX=6.8                          # load de 1 min acima disto: não despacha
CARGA_CRITICA=12                       # load acima disto: pausa de proteção
RESERVA_MEM_GB=5                       # memória que fica para o usuário
MEM_POR_AGENTE_GB=2.5                  # estimativa por agente, com os testes dele
PSI_CPU_MAX=40                         # % de pressão de CPU (some avg10) que trava despacho
PSI_MEM_MAX=10                         # % de pressão de memória (some avg10) que trava despacho
SLOTS_BUILD=1                          # bin/slot: builds simultâneos
SLOTS_TEST=2                           # suítes de teste simultâneas
SLOTS_BROWSER=2                        # navegadores headless simultâneos
SLOTS_INSTALL=1                        # instalações de dependências simultâneas
SLOT_MEM_MAX="6G"                      # teto de memória por comando pesado (systemd-run); vazio desliga
SLOT_ESPERA_MAX_MIN=15                 # espera máxima por uma vaga; depois o slot sai com código 75

# Ambiente de teste e autenticação (AMBIENTE.md): só localhost e homologação
HML_URL="http://localhost:3000"        # onde os agentes testam
HML_LOGIN_URL=""                       # página de login, se não for a HML_URL
HML_LOGIN_USUARIO=""                   # seletor do campo de usuário (vazio: e-mail ou texto), ex.: '[placeholder="Insira seu e-mail"]'
HML_LOGIN_SENHA=""                     # seletor do campo de senha (vazio: input[type=password])
HML_LOGIN_BOTAO=""                     # seletor do botão de entrar (vazio: Enter na senha), ex.: 'text=Entrar no sistema'
HML_LOGIN_AVANCAR=""                   # login em duas etapas: botão entre usuário e senha (vazio: Avançar, Próximo, Continuar)
HML_LOGIN_OK=""                        # trecho (regex) da URL depois do login, ex.: /home
HML_LOGIN_ROTEIRO=""                   # vazio: bin/hml-login.js com os seletores acima; ou o caminho de um roteiro próprio
HML_PLAYWRIGHT=""                      # pasta do playwright-core, se não estiver no projeto nem em <estado>/harness
HML_SERVIDOR=""                        # sobe o app local para o hml vivo, ex.: PORT=3000 BROWSER=none yarn start
HML_SERVIDOR_DIR=""                    # onde o HML_SERVIDOR roda (com as dependências); vazio: CHECKOUT
HOSTS_PERMITIDOS="localhost 127.0.0.1 ::1"   # acrescente o domínio de homologação, ex.: *.staging.meuapp.dev
HOSTS_PROIBIDOS=""                     # produção, ex.: meuapp.dev *.meuapp.dev
HML_CONTA=""                           # nome da conta de teste (ex.: meuapp-hml); orquestrações do mesmo projeto compartilham
HML_COFRE="chaveiro"                   # chaveiro (secret-tool) | arquivo (~/.local/share/orquestrador-t3-pessoal/hml/<conta>/hml.env, 600)

# Provas (PROVAS.md)
PROVAS_PR="comentario"                 # comentario: resumo das provas e revisão num comentário do PR | desligado
PROVA_MAX_MB=20                        # tamanho máximo de cada arquivo de prova
PROVA_VIDEO_MAX_S=90                   # duração máxima de cada vídeo

# Despertar e pausa
HEARTBEAT_MIN=30
PAUSA_PRAZO_MIN=15
PAUSA_IMEDIATA_SEG=120

# Modelos (provedor:modelo:effort; ver MODELOS.md). O modelo vem da classe da tarefa; o effort, da classe ou do
# campo **Effort:** da tarefa. Acima de high só com ganho medido e o "pode" do usuário.
ORQUESTRADOR="claudeAgent:claude-opus-5-5:medium"      # loop; épico grande: claudeAgent:claude-fable-5-2:medium
PLANO_REVISOR="claudeAgent:claude-fable-5-2:high"      # uma chamada, antes do loop
MODELO_P="claudeAgent:claude-sonnet-5-5:medium"
MODELO_M="claudeAgent:claude-sonnet-5-5:high"
MODELO_G="claudeAgent:claude-opus-5-5:high"
MODELO_GG="claudeAgent:claude-fable-5-2:high"
REVISOR="codex:gpt-6.1-sol:low"                        # low é o padrão do Sol no Codex e o que cabe no limite de uso
REVISOR_CRITICO="codex:gpt-6.1-sol:medium"             # classes G e GG; vazio = REVISOR
REVISOR_RESERVA="claudeAgent:claude-opus-5-5:high"     # quando o provedor do revisor sai do ar ou bate no limite
# Ordem de subida no escalonamento (alvo.py --acima): mais effort até high, depois o modelo seguinte em medium.
ESCADA="claudeAgent:claude-sonnet-5-5:medium claudeAgent:claude-sonnet-5-5:high claudeAgent:claude-opus-5-5:medium claudeAgent:claude-opus-5-5:high claudeAgent:claude-fable-5-2:medium claudeAgent:claude-fable-5-2:high"
